# Flashnet Orchestra (swap/bridge routing). Quoting works without a key;
# submitting an order requires one.
#
# Anything prefixed EXPO_PUBLIC_ is embedded in the app bundle and readable by
# anyone who unzips the build — use a scoped CLIENT key here, never a backend
# admin key. Set AUTH_MODE=admin only when proxying through your own server.
EXPO_PUBLIC_FLASHNET_API_KEY=PUT_FLASHNET_CLIENT_KEY_HERE
EXPO_PUBLIC_FLASHNET_AUTH_MODE=client
# Optional: point at your own Orchestra proxy instead of the public API.
# EXPO_PUBLIC_FLASHNET_BASE_URL=https://orchestration.flashnet.xyz
